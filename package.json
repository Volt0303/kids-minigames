{
  "name": "kids-minigames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Six mini-games for preschool children on Android tablets (one codebase, six APKs).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings=0 src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node tools/check-file-size.mjs",
    "verify": "npm run check:size && npm run lint && npm run format:check && npm run typecheck && npm test",
    "cap:sync": "npm run build && cap sync android",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
